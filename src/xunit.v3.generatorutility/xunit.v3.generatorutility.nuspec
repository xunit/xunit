<?xml version="1.0" encoding="utf-8"?>
<package>
	<metadata>
		<id>xunit.v3.generatorutility</id>
		<version>$PackageVersion$</version>
		<title>xUnit.net v3 [Source Generator Utility, as C# source]</title>
		<authors>jnewkirk,bradwilson</authors>
		<requireLicenseAcceptance>false</requireLicenseAcceptance>
		<license type="expression">Apache-2.0</license>
		<licenseUrl>https://licenses.nuget.org/Apache-2.0</licenseUrl>
		<icon>_content/logo-128-transparent.png</icon>
		<readme>_content/README.md</readme>
		<releaseNotes>https://xunit.net/releases/v3/$PackageVersion$</releaseNotes>
		<description>Includes the current source generation utility classes from xUnit.net, as source into your project. Supports any platform(s) compatible with .NET Standard 2.0 and C# 9.</description>
		<copyright>Copyright (C) .NET Foundation</copyright>
		<repository type="git" url="https://github.com/xunit/xunit" commit="$GitCommitId$" />
		<dependencies>
			<group targetFramework="netstandard2.0">
				<dependency id="Microsoft.CodeAnalysis.CSharp" version="4.3.0" />
			</group>
		</dependencies>
		<contentFiles>
			<files include="contentFiles/cs/netstandard2.0/**/*.cs" buildAction="Compile" />
		</contentFiles>
	</metadata>
	<files>
		<file target="_content\" src="..\..\tools\media\logo-128-transparent.png" />
		<file target="_content\README.md" src="obj\xunit.v3.generatorutility.README.md" />

		<file target="contentFiles\.editorconfig" src="..\build\.nuget.editorconfig" />
		<file target="contentFiles\cs\netstandard2.0\xunit.v3.generatorutility" src="**\*.cs" exclude="obj\**\*.cs" />

		<file target="lib\netstandard2.0\_._" src="..\build\_._" />
	</files>
</package>
